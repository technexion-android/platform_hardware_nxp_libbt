cc_defaults {
    name: "firmware_loader_v3",
    srcs: ["fw_loader_uart.c"],
    cflags: ["-DUART_DOWNLOAD_FW"],
}

cc_defaults {
    name: "firmware_loader_v2",
    srcs: ["fw_loader_uart_v2.c"],

    cflags: [
        "-DUART_DOWNLOAD_FW",
        "-DFW_LOADER_V2",
    ],
}

cc_library_shared {
    name: "libbt-vendor-nxp",
    include_dirs: [
        "hardware/interfaces/bluetooth/1.0/default",
    ],
    local_include_dirs: ["conf/nxp/"],
    srcs: [
        "bt_vendor_nxp.c",
        "fw_loader_io.c",
        "hardware_nxp.c",
    ],
    //firmware loader v2 version is only applicable for 8887-FP101 and other SoC's support v3
    defaults: ["firmware_loader_v3"],

    cflags: [
        "-DVHAL_LOG_LEVEL=5",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
        "libbase",
    ],
    proprietary: true,
    owner: "nxp",
}

bootstrap_go_package {
    name: "soong-libbt_vendor",
    pkgPath: "android/soong/hardware/nxp/libbt",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: ["libbt_vendor.go"],
    pluginFor: ["soong_build"],
}
